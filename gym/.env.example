# Supabase project credentials (Project Settings > API)
# Safe to expose in the browser — these are public keys protected by Row Level Security.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# NEVER put the service_role key in this file or in any frontend code.
